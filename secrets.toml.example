# Copy this file to secrets.toml and fill in your own values.
# NEVER commit secrets.toml to GitHub.

GEMINI_API_KEY = "your-gemini-api-key"

# Gmail needs 2-Step Verification ON, then create an App Password at
# myaccount.google.com/apppasswords (16 characters, no spaces).
GMAIL_ADDRESS = "yourname@gmail.com"
GMAIL_APP_PASSWORD = "xxxxxxxxxxxxxxxx"
